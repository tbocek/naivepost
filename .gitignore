# media and generated artifacts stay out of git -- gui/ is the prototype, rust/ the rewrite.
# Every rule is anchored (leading /): unanchored, `cut/` or `test*` also match
# rust/src/cut/ or rust/tests/ and silently keep the rewrite's sources out of git.
/input_audio/
/input_video/
/out/
/llm.conf
/gui/naivepost-gui
/gui/gui
/gui/vendor/
/dist/
/.flatpak-builder/

# project folders and files the prototype writes when run from the repo
/step*/
/inputs/
/understand/
/cut/
/narrate/
/produce/
/publish/
/cache
/*.json
/test*
/gui/step*/
/gui/inputs/
/gui/understand/
/gui/cut/
/gui/narrate/
/gui/produce/
/gui/publish/
/gui/cache
/gui/*.json
/gui/test*

# the rewrite's build output
/rust/target/
/rust/shots/

# a session folder the app writes when it is launched from `rust/` itself; anchored so it cannot
# match a real project folder or anything under rust/src
/rust/session.naivepost/

# extracted frames the snapshot bench writes into the demo fixture so the Cut page's preview has a
# real JPEG to decode; generated, like the shot beside it
/rust/fixtures/demo.naivepost/prepare/
# the built-in card badges and the video card `05-insert` stages with: `press_insert` seeds `assets/` on
# first open for a real project too, so the snapshot's copy of that work is generated, not authored
/rust/fixtures/demo.naivepost/assets/
/rust/fixtures/demo.naivepost/f2-12-sting.mp4
.codehalter/
